# Copy this file to config/.env and fill in the values. config/.env is gitignored.

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
# Model used by the computer-use agent (check your account's access).
# gpt-6.1-sol is ~5x cheaper than gpt-6-astra; switch to gpt-6-astra if accuracy is not good enough.
OPENAI_MODEL=gpt-6.1-sol

# --- Jira Cloud -----------------------------------------------------------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN

# Test cases: issues returned by this JQL. Each description holds a numbered list of steps.
JIRA_TEST_JQL="project = KAN AND labels = ai-test ORDER BY key ASC"
JIRA_TEST_ISSUE_TYPE=Task
JIRA_TEST_LABEL=ai-test

# Execution issue the results are written back to.
# Leave JIRA_EXECUTION_ISSUE_KEY empty to create a new issue for every run.
JIRA_EXECUTION_ISSUE_KEY=
JIRA_EXECUTION_ISSUE_TYPE=Task
JIRA_EXECUTION_SUMMARY_PREFIX=AI test execution
JIRA_EXECUTION_LABEL=ai-test-execution

# Pass/Fail write-back. Standard Jira issues have no pass/fail field, so we use
# labels and (optionally) a workflow transition. Leave transitions empty to skip them.
JIRA_PASS_LABEL=ai-test-passed
JIRA_FAIL_LABEL=ai-test-failed
JIRA_TRANSITION_PASS=
JIRA_TRANSITION_FAIL=
JIRA_ADD_COMMENT=true
# Also attach every step screenshot as a separate file (the HTML report already embeds them)
JIRA_ATTACH_SCREENSHOTS=false

# --- Public site used for the sample tests (seed script only) --------------
SAMPLE_SITE_URL=https://the-internet.herokuapp.com
SAMPLE_USERNAME=tomsmith
SAMPLE_PASSWORD=SuperSecretPassword!

# --- Execution ------------------------------------------------------------
# Origins the browser may open, comma separated (hostnames, origins or *.wildcards).
# Everything else is denied when ORIGIN_APPROVAL_MODE=allowlist.
ALLOWED_ORIGINS=https://the-internet.herokuapp.com
# allowlist = auto approve allowed, deny the rest | prompt = ask in the terminal
ORIGIN_APPROVAL_MODE=allowlist
STEP_TIMEOUT_MS=180000
STOP_ON_FAIL=true

# --- Local folders --------------------------------------------------------
DATA_DIR=data
OUTPUT_DIR=output
